# --- Database ---
# For Docker copy .env.docker.example. For local Windows copy .env.windows.example.
DATABASE_URL="postgresql://amb@127.0.0.1:55432/auto_monitor?schema=public"
POSTGRES_SHARED_BUFFERS=32MB
POSTGRES_MAX_CONNECTIONS=50
DATABASE_POOL_MAX=6
DATABASE_CONNECT_TIMEOUT_MS=3000

# --- Redis (BullMQ queues) ---
REDIS_URL="redis://127.0.0.1:6380"

# --- Telegram Bot (grammY) ---
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=""
# Your personal chat id (send /start to the bot, or use @userinfobot)
TELEGRAM_CHAT_ID=""
# Control panel in the same Telegram bot: start/stop/live/status/scan buttons.
TELEGRAM_CONTROL_BOT_ENABLED=true
TELEGRAM_CONTROL_NOTIFY_ON_START=true

# --- API server ---
API_PORT=4000
API_HOST=127.0.0.1
DASHBOARD_ORIGIN="http://localhost:3001"
INTERNAL_API_URL="http://127.0.0.1:4000"
INTERNAL_API_TIMEOUT_MS=15000
BFF_MAX_BODY_BYTES=1000000
DASHBOARD_AUTH_SECRET=""
BACKUP_ENCRYPTION_PASSWORD=""
BACKUP_MIRROR_PATH=""
API_REQUIRE_LOCAL_TOKEN_FOR_ALL=true
LOCAL_API_TOKEN=""

# --- Monitoring ---
# Base polling interval in seconds (default 120 = 2 minutes)
MONITOR_INTERVAL_SECONDS=120
# Jitter in seconds (random +/- added to each cycle)
MONITOR_JITTER_SECONDS=20
SCHEDULER_MIN_SLEEP_MS=100
SCHEDULER_MAX_SLEEP_MS=1000
BACKFILL_INTERVAL_SECONDS=300
OLX_BACKFILL_MIN_INTERVAL_SECONDS=900
BACKFILL_INITIAL_DELAY_SECONDS=60
WORKER_HEARTBEAT_STALE_SECONDS=600
LIVE_OLX_INTERVAL_SECONDS=20
LIVE_OLX_JITTER_SECONDS=4
OLX_CADENCE_CANARY_ENABLED=true
OLX_CADENCE_CANARY_QUALIFICATION_RUNS=100
OLX_CADENCE_CANARY_PROMOTION_RUNS=100
OLX_CADENCE_CANARY_INTERVAL_SECONDS=15
OLX_CADENCE_CANARY_JITTER_SECONDS=3
OLX_CADENCE_CANARY_QUALIFICATION_MAX_P95_MS=8000
OLX_CADENCE_CANARY_MAX_P95_MS=12000
OLX_CADENCE_CANARY_P95_MIN_SAMPLES=10
OLX_CADENCE_CANARY_P95_GROWTH_PERCENT=125
OLX_CADENCE_CANARY_QUEUE_DEPTH_LIMIT=25
OLX_REALTIME_RECOVERY_RAMP_SECONDS=1800
LIVE_CARS_UA_INTERVAL_SECONDS=15
LIVE_CARS_UA_JITTER_SECONDS=3
LIVE_AUTOMOTO_INTERVAL_SECONDS=60
LIVE_AUTOMOTO_JITTER_SECONDS=10
LIVE_RST_INTERVAL_SECONDS=120
LIVE_RST_JITTER_SECONDS=20
LIVE_AUTO_RIA_MIN_INTERVAL_SECONDS=60
LIVE_AUTO_RIA_JITTER_SECONDS=5
AUTO_RIA_SEARCH_REQUESTS_PER_HOUR=30
# Allow dashboard "SCAN NOW" even if scheduled monitoring is stopped.
ALLOW_MANUAL_CHECK_WHEN_STOPPED=true
# Deduplicate repeated manual checks for the same source.
MANUAL_CHECK_DEDUP_SECONDS=30
INITIAL_WINDOW_BEHAVIOR=SKIP_EXISTING
MAX_INITIAL_WINDOW_NOTIFICATIONS=50

# --- Collectors ---
# AUTO.RIA developers API key/user id. Empty means AUTO.RIA is not configured.
AUTO_RIA_API_KEY=""
AUTO_RIA_USER_ID=""
AUTO_RIA_TOTAL_REQUEST_LIMIT=1000
AUTO_RIA_HOURLY_REQUEST_LIMIT=30
AUTO_RIA_SOFT_RESERVE=100
AUTO_RIA_MIN_SEARCH_RESERVE=50
AUTO_RIA_MAX_INFO_PER_SCAN=10
AUTO_RIA_PAID_ENRICHMENT_ENABLED=false
AUTO_RIA_VIN_LOOKUP_ENABLED=false
AUTO_RIA_AVERAGE_PRICE_ENABLED=false
MOCK_SOURCE_ENABLED=false
FAKE_VEHICLE_CHECK_ENABLED=false
NHTSA_VPIC_ENABLED=true
NHTSA_VPIC_TIMEOUT_MS=3000
NHTSA_RECALLS_ENABLED=true
NHTSA_RECALLS_TIMEOUT_MS=3000
NHTSA_COMPLAINTS_ENABLED=true
NHTSA_COMPLAINTS_TIMEOUT_MS=3000
NHTSA_SAFETY_RATINGS_ENABLED=true
NHTSA_SAFETY_RATINGS_TIMEOUT_MS=3000
DATA_GOV_UA_STOLEN_ENABLED=true
DATA_GOV_UA_STOLEN_TIMEOUT_MS=8000
DATA_GOV_UA_STOLEN_CACHE_MS=21600000
DATA_GOV_UA_STOLEN_URL=https://data.gov.ua/dataset/2cd12755-834b-4c43-9026-fe356ce93af5/resource/2d69d196-02f1-49b9-97fa-0fb69077e05f/download/carswanted.json
PHOTO_IDENTIFIER_OCR_ENABLED=true
PHOTO_IDENTIFIER_OCR_MAX_IMAGES=2
PHOTO_IDENTIFIER_OCR_MAX_BYTES=8000000
PHOTO_IDENTIFIER_OCR_DOWNLOAD_TIMEOUT_MS=5000
PHOTO_IDENTIFIER_OCR_RECOGNIZE_TIMEOUT_MS=12000
FAST_INLINE_TELEGRAM_SEND_ENABLED=true
FAST_INLINE_LISTING_PROCESSING_ENABLED=true
# Keep only the newest match on the collector critical path. Remaining burst
# matches are persisted and queued so Telegram cannot delay the next OLX scan.
FAST_INLINE_LISTING_LIMIT_PER_RUN=1
FAST_INLINE_LISTING_CONCURRENCY=4
FAST_INLINE_TELEGRAM_DEADLINE_MS=4000
TELEGRAM_LISTING_SEND_MIN_INTERVAL_MS=1100
TELEGRAM_FLASH_BUNDLE_ENABLED=true
TELEGRAM_FLASH_BUNDLE_MIN_ITEMS=2
TELEGRAM_FLASH_BUNDLE_MAX_ITEMS=20
WORKER_CONCURRENCY_TELEGRAM_FLASH=1
WORKER_CONCURRENCY_TELEGRAM_SEND=6
WORKER_CONCURRENCY_TELEGRAM_UPDATE=4
WORKER_CONCURRENCY_LISTING_DETECTED=6
WORKER_CONCURRENCY_LISTING_ENRICH=3
WORKER_CONCURRENCY_VEHICLE_CHECK=3
WORKER_CONCURRENCY_COLLECTOR_RUN=3
WORKER_CONCURRENCY_COLLECTOR_COVERAGE=1
WORKER_CONCURRENCY_COLLECTOR_BACKFILL=1
WORKER_CONCURRENCY_OBSERVATION_REPLAY=1
OBSERVATION_REPLAY_INTERVAL_MS=30000
OBSERVATION_REPLAY_LOOKBACK_HOURS=48
OBSERVATION_REPLAY_LIMIT=500
RETENTION_INTERVAL_MS=21600000
RETENTION_COLLECTOR_RUN_DAYS=7
RETENTION_ERROR_LOG_DAYS=90
RETENTION_AUDIT_DAYS=90
RETENTION_OBSERVATION_DAYS=365
# Listing cards are removed from the project after 12 hours. Telegram cleanup
# is checked every 5 minutes; a saved card is retained for 10 days.
LISTING_RETENTION_HOURS=12
LISTING_FAVORITE_RETENTION_DAYS=10
LISTING_CLEANUP_INTERVAL_MS=300000
LISTING_CLEANUP_BATCH_SIZE=50
REALTIME_MAX_CANDIDATES=250
BACKFILL_MAX_PAGES=4
BACKFILL_MAX_CANDIDATES=800
BACKFILL_MAX_DURATION_MS=90000
MAX_SCAN_DURATION_MS=20000
SOURCE_EMPTY_RESULT_WARNING_THRESHOLD=3
COLLECTOR_LOCK_RETRY_MAX=3
COLLECTOR_LOCK_RETRY_DELAY_MS=750
HOT_DUPLICATE_TTL_SECONDS=120
STARTUP_RECOVERY_LIMIT=500
PIPELINE_RECOVERY_INTERVAL_MS=120000

# OLX search URLs are built automatically (geo scopes + newest-first order).
# Optional private-sellers pass (owner_type=private); doubles OLX request volume.
OLX_PRIVATE_FEED_ENABLED=false
OLX_INCLUDE_REFRESHED=false
OLX_MAX_NEW_PER_RUN=250
# Verified OLX web API limits: limit <= 50, offset <= 1000.
OLX_API_PAGE_SIZE=50
OLX_API_MAX_OFFSET=1000
# Clears only the lightweight OLX seen-ID cache; saved listings remain intact.
OLX_KNOWN_IDS_RESET_THRESHOLD=2000
KNOWN_LISTING_STOP_THRESHOLD=10
OLX_REALTIME_MAX_PAGES=1
OLX_BACKFILL_MAX_PAGES=20
OLX_MIN_EXPECTED_PAGE_ITEMS=10
OLX_REQUEST_TIMEOUT_MS=8000
OLX_COVERAGE_INTERVAL_SECONDS=60
OLX_COVERAGE_INITIAL_DELAY_SECONDS=30
OLX_COVERAGE_MAX_DURATION_MS=30000
OLX_HTML_COVERAGE_INTERVAL_SECONDS=60
OLX_PRIVATE_COVERAGE_INTERVAL_SECONDS=90
OLX_HTML_DETAIL_MAX_PER_SCAN=6
OLX_BACKFILL_PAGE_DELAY_MS=750
OLX_BACKFILL_REALTIME_QUIET_MS=250
OLX_BACKGROUND_REQUEST_MIN_INTERVAL_MS=3500
OLX_BACKGROUND_AFTER_REALTIME_QUIET_MS=1000
# After 100 clean realtime origin requests, canary only the serialized
# post-finish floor 350 -> 150 ms. Protection/error/queue/p95 regressions
# immediately roll it back for the rest of the worker session.
OLX_REALTIME_QUIET_CANARY_ENABLED=true
OLX_REALTIME_QUIET_CANARY_CANDIDATE_MS=150
OLX_REALTIME_QUIET_CANARY_QUALIFICATION_REQUESTS=100
OLX_REALTIME_QUIET_CANARY_EVALUATION_REQUESTS=30
OLX_REALTIME_QUIET_CANARY_P95_GROWTH_PERCENT=120
OLX_REALTIME_QUIET_CANARY_QUEUE_DEPTH_LIMIT=25
OLX_PROTECTION_COOLING_SECONDS=1800
OLX_OUTAGE_DETECTION_SECONDS=120
OLX_OUTAGE_RECOVERY_LOOKBACK_HOURS=48
OLX_OUTAGE_SAFETY_OVERLAP_SECONDS=300
# Rate-limit pauses honor Retry-After and grow exponentially from the base.
RATE_LIMIT_PAUSE_BASE_SECONDS=90
RATE_LIMIT_PAUSE_MAX_SECONDS=3600
CAPTCHA_PAUSE_SECONDS=900
CAPTCHA_PAUSE_MAX_SECONDS=3600
MARKET_RESEARCH_OLX_MAX_PAGES=4
MARKET_RESEARCH_MAX_COMPARABLES=160
MARKET_RESEARCH_CACHE_TTL_SECONDS=21600
MARKET_RESEARCH_DEADLINE_MS=12000
RST_SEARCH_URL="https://rst.ua/ukr/oldcars/"
CARS_UA_SEARCH_URL="https://cars.ua/"
CARS_UA_MAX_NEW_PER_RUN=40
CARS_UA_REALTIME_MAX_PAGES=3
AUTOMOTO_SEARCH_URL="https://automoto.ua/uk/car?order=addDate"
AUTOMOTO_REQUEST_TIMEOUT_MS=8000

# Shared HTTP client for public source collectors.
SOURCE_HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36"
SOURCE_HTTP_TIMEOUT_MS=10000
SOURCE_HTTP_MAX_RESPONSE_BYTES=5000000
SOURCE_HTTP_CONNECTIONS_PER_ORIGIN=4
SOURCE_HTTP_TRANSIENT_RETRY_COUNT=3
SOURCE_HTTP_TRANSIENT_RETRY_BASE_DELAY_MS=1000

# Used to normalize OLX UAH prices into the same internal USD-like price range as AUTO.RIA/RST.
PRICE_UAH_PER_USD=44.65
