{
  "name": "auto-monitor-bot",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "postcss": "8.5.21",
      "shell-quote": "1.9.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @amb/dashboard dev",
    "dev:api": "pnpm --filter @amb/api dev",
    "dev:worker": "pnpm --filter @amb/worker dev",
    "dev:all": "concurrently -n dashboard,api,worker -c yellow,cyan,green \"pnpm --filter @amb/dashboard dev\" \"pnpm --filter @amb/api dev\" \"pnpm --filter @amb/worker dev\"",
    "docker:start": "docker compose up -d",
    "windows:start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "local:dev": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1 -Dev",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "local:status": "powershell -ExecutionPolicy Bypass -File scripts/status.ps1",
    "local:restart": "pnpm local:stop && pnpm local:start",
    "redis:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-redis-windows.ps1",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File scripts/remove-autostart.ps1",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-android.ps1",
    "remote:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-tailscale-access.ps1 -BuildAndroidApp",
    "remote:status": "powershell -ExecutionPolicy Bypass -File scripts/setup-tailscale-access.ps1 -StatusOnly",
    "auth:seed": "node scripts/seed-dashboard-user.mjs",
    "doctor": "node scripts/doctor.mjs",
    "package:project": "powershell -ExecutionPolicy Bypass -File scripts/package-project.ps1",
    "worker": "pnpm --filter @amb/worker dev",
    "clean": "pnpm clean:dashboard",
    "clean:dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$paths=@('apps/dashboard/.next','apps/dashboard/tsconfig.tsbuildinfo'); foreach($p in $paths){ if(Test-Path $p){ Remove-Item -LiteralPath $p -Recurse -Force } }\"",
    "rebuild": "pnpm clean && pnpm build",
    "build": "pnpm -r --if-present build",
    "check": "pnpm db:validate && pnpm typecheck && pnpm lint && pnpm test:powershell && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm android:check",
    "browser:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright.ps1 -Install",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playwright.ps1",
    "db:generate": "pnpm --filter @amb/db db:generate",
    "db:migrate": "pnpm --filter @amb/db db:migrate",
    "db:migrate:dev": "pnpm --filter @amb/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @amb/db db:migrate:deploy",
    "db:push": "pnpm --filter @amb/db db:push",
    "db:seed": "pnpm --filter @amb/db db:seed",
    "db:studio": "pnpm --filter @amb/db db:studio",
    "db:validate": "pnpm --filter @amb/db db:validate",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-database.ps1 -Force",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "lint": "eslint .",
    "test": "vitest run",
    "test:powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-powershell.ps1",
    "typecheck": "pnpm -r --no-bail --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "1.61.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "next": "^15.1.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "3.2.6"
  }
}
