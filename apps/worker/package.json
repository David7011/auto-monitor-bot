{
  "name": "@amb/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "maintenance:retention": "tsx src/maintenance/retention-cli.ts",
    "maintenance:listings": "tsx src/maintenance/listing-retention-cli.ts",
    "metrics:telegram:24h": "tsx src/maintenance/telegram-latency-cli.ts",
    "test:olx-parity": "tsx src/maintenance/olx-parity-cli.ts",
    "test:telegram-global-gate": "tsx src/maintenance/telegram-rate-gate-acceptance.ts",
    "dev": "tsx watch src/index.ts",
    "dev:hot": "tsx watch src/index.ts --role=hot --instance=a",
    "dev:hot:a": "tsx watch src/index.ts --role=hot --instance=a",
    "dev:hot:b": "tsx watch src/index.ts --role=hot --instance=b",
    "dev:background": "tsx watch src/index.ts --role=background",
    "start": "node --conditions=production dist/index.js",
    "start:hot": "node --conditions=production dist/index.js --role=hot --instance=a",
    "start:hot:a": "node --conditions=production dist/index.js --role=hot --instance=a",
    "start:hot:b": "node --conditions=production dist/index.js --role=hot --instance=b",
    "start:background": "node --conditions=production dist/index.js --role=background",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@amb/db": "workspace:*",
    "@amb/shared": "workspace:*",
    "abort-controller": "3.0.0",
    "bullmq": "^5.81.2",
    "dotenv": "^16.6.1",
    "grammy": "^1.45.1",
    "ioredis": "^5.11.1",
    "tesseract.js": "^7.0.0",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "5.7.3"
  }
}
